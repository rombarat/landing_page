# ---------------------------------------------------------------------------
# Dukan environment. Copy to .env.local for local development.
# Local development values are generated by `npm run local:up`.
# ---------------------------------------------------------------------------

# Public URL of this deployment (used in links, emails redirects, share URLs).
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Supabase project (Settings → API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose. Used for Storage uploads after membership checks.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY. Postgres connection used by the app (RLS enforced per request).
# Use the Supabase *transaction pooler* string (port 6543) on Vercel:
# postgres://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOL_MAX=5

# Media storage: "supabase" (default) or "local" (development only).
STORAGE_DRIVER=supabase
# Optional override of the public media base URL. Defaults to
# NEXT_PUBLIC_SUPABASE_URL + /storage/v1/object/public/store-media
NEXT_PUBLIC_MEDIA_BASE_URL=

# SERVER ONLY. Random secret used to hash customer IPs for order rate limiting.
ORDER_IP_SALT=change-me-to-a-long-random-string

# Where merchants contact you to activate a subscription (shown on the billing page).
PLATFORM_SUPPORT_EMAIL=
PLATFORM_SUPPORT_WHATSAPP=

# Optional AI product suggestions (off unless both are set). Paid API usage.
AI_ENRICHMENT_PROVIDER=
ANTHROPIC_API_KEY=
AI_ENRICHMENT_MODEL=
